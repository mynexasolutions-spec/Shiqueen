# Copy to .env and fill in. Only NEXT_PUBLIC_* values ever reach the browser.

# Supabase Postgres (Project Settings → Database → Connection string)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-ap-south-1.pooler.supabase.com:5432/postgres

# Random 48+ character string. Signs email OTP codes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# ImageKit (Developer options → API keys)
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/<your-id>
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=

# Brevo transactional email (SMTP & API → API keys). Sender must be verified in Brevo.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@shiqueen.in
BREVO_SENDER_NAME=ShiQueen
